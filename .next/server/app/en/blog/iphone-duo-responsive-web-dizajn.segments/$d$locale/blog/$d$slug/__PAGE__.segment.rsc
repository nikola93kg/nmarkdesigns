5",{"property":"og:image:type","content":"image/jpeg"}],["$","meta","16",{"property":"og:image:width","content":"1312"}],["$","meta","17",{"property":"og:image:height","content":"738"}],["$","meta","18",{"property":"og:image:alt","content":"Apple iPhone Duo open in hands with the large inner display visible."}],["$","meta","19",{"property":"og:locale:alternate","content":"sr_RS"}],["$","meta","20",{"property":"og:type","content":"article"}],["$","meta","21",{"property":"article:published_time","content":"2026-09-15"}],["$","meta","22",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","23",{"name":"twitter:title","content":"iPhone Duo and the future of responsive web design | NMark Designs"}],["$","meta","24",{"name":"twitter:description","content":"Apple's foldable iPhone Duo shows why a mobile website can no longer be checked on one phone and a few breakpoints."}],["$","meta","25",{"name":"twitter:image","content":"https://nmarkdesigns.com/blog/apple-iphone-duo-opening.jpg"}],["$","meta","26",{"name":"twitter:image:alt","content":"Apple iPhone Duo open in hands with the large inner display visible."}],["$","meta","27",{"name":"twitter:image:type","content":"image/jpeg"}],["$","meta","28",{"name":"twitter:image:width","content":"1312"}],["$","meta","29",{"name":"twitter:image:height","content":"738"}],["$","link","30",{"rel":"shortcut icon","href":"/web-app-manifest-192x192.png"}],["$","link","31",{"rel":"icon","href":"/web-app-manifest-192x192.png","sizes":"192x192","type":"image/png"}],["$","link","32",{"rel":"icon","href":"/web-app-manifest-512x512.png","sizes":"512x512","type":"image/png"}],["$","link","33",{"rel":"apple-touch-icon","href":"/web-app-manifest-192x192.png","sizes":"192x192","type":"image/png"}],["$","$L2d","34",{}]]}]}]}],null]}]
