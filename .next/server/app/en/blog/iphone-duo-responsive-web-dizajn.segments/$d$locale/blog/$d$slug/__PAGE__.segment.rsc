2:T659,{"@context":"https://schema.org","@graph":[{"@type":"BlogPosting","@id":"https://nmarkdesigns.com/en/blog/iphone-duo-responsive-web-dizajn/#article","url":"https://nmarkdesigns.com/en/blog/iphone-duo-responsive-web-dizajn/","headline":"iPhone Duo changes responsive web design — is your website ready for foldable phones?","description":"Apple's foldable iPhone Duo shows why a mobile website can no longer be checked on one phone and a few breakpoints.","abstract":"Apple introduced iPhone Duo on September 9, 2026, its first foldable iPhone with a 7.6-inch inner display. For website owners, that is not just device news: it is a reminder that responsive web design has to work across a range of widths, densities, and device states, not only on one phone.","inLanguage":"en","datePublished":"2026-09-15","image":"https://nmarkdesigns.com/blog/apple-iphone-duo-opening.jpg","mainEntityOfPage":"https://nmarkdesigns.com/en/blog/iphone-duo-responsive-web-dizajn/","publisher":{"@id":"https://nmarkdesigns.com/#organization"},"articleSection":"Responsive web design","citation":["https://www.apple.com/newsroom/2026/09/apple-unveils-iphone-duo/","https://developer.mozilla.org/en-US/docs/Learn_web_development/Core/CSS_layout/Responsive_Design","https://web.dev/learn/design"]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Blog","item":"https://nmarkdesigns.com/en/blog/"},{"@type":"ListItem","position":2,"name":"iPhone Duo changes responsive web design — is your website ready for foldable phones?","item":"https://nmarkdesigns.com/en/blog/iphone-duo-responsive-web-dizajn/"}]}]}10:X
