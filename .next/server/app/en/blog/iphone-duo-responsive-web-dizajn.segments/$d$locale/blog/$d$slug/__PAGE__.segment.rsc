a:["$","$L1a",null,{"url":"https://nmarkdesigns.com/en/blog/iphone-duo-responsive-web-dizajn/","title":"iPhone Duo changes responsive web design — is your website ready for foldable phones?","labels":{"title":"Share this article","intro":"Send the article to someone who may find it useful.","facebook":"Facebook","linkedin":"LinkedIn","x":"X","instagram":"Instagram","copy":"Copy link","copied":"Link copied.","instagramLabel":"Copy the link for sharing on Instagram","copyLabel":"Copy article link"}}]
b:["$","div",null,{"className":"Blog_body__3F_4b","children":[["$","aside",null,{"className":"Blog_answer__uX72u","aria-label":"The short answer","children":[["$","h2",null,{"className":"text-subheading font-semibold","children":"The short answer"}],["$","p",null,{"children":"Apple introduced iPhone Duo on September 9, 2026, its first foldable iPhone with a 7.6-inch inner display. For website owners, that is not just device news: it is a reminder that responsive web design has to work across a range of widths, densities, and device states, not only on one phone."}]]}],["$","figure",null,{"className":"Blog_figure__N482F","children":[["$","div",null,{"className":"Blog_image__Wh83s","children":["$","$L3",null,{"src":"/blog/apple-iphone-duo-opening.webp","alt":"Apple iPhone Duo open in hands with the large inner display visible.","width":1312,"height":738,"sizes":"(max-width: 767px) 100vw, 65vw"}]}],["$","figcaption",null,{"children":"The open inner display of iPhone Duo changes what visitors expect from a mobile website. Image source: Apple Newsroom."}]]}],[["$","section","The Apple news is only the starting point",{"id":"section-1","children":[["$","h2",null,{"className":"text-heading font-semibold text-ink","children":"The Apple news is only the starting point"}],[["$","p","Apple introduced iPhone Duo on September 9, 2026 as its first foldable iPhone. According to Apple's announcement, the device has a 5.4-inch outer display and a 7.6-inch inner display, with pre-orders beginning October 16 and availability beginning October 23.",{"className":"text-muted","children":"Apple introduced iPhone Duo on September 9, 2026 as its first foldable iPhone. According to Apple's announcement, the device has a 5.4-inch outer display and a 7.6-inch inner display, with pre-orders beginning October 16 and availability beginning October 23."}],["$","p","So this article is not a standard Apple news story. The more useful question for business owners is simple: if someone opens your website on a device that behaves like a phone one moment and almost like a tablet the next, does the page still feel intentional, readable, and useful?",{"className":"text-muted","children":"So this article is not a standard Apple news story. The more useful question for business owners is simple: if someone opens your website on a device that behaves like a phone one moment and almost like a tablet the next, does the page still feel intentional, readable, and useful?"}]],"$undefined",[["$","figure","/blog/apple-iphone-duo-colors.webp",{"className":"Blog_figure__N482F","children":[["$","div",null,{"className":"Blog_image__Wh83s","children":["$","$L3",null,{"src":"/blog/apple-iphone-duo-colors.webp","alt":"Apple iPhone Duo shown in light and dark finishes, both open and closed.","width":980,"height":551,"sizes":"(max-width: 767px) 100vw, 65vw","loading":"eager"}]}],["$","figcaption",null,{"children":"iPhone Duo in two finishes and two device states. Image source: Apple Newsroom."}]]}]]]}],["$","section","The new form factor breaks comfortable assumptions",{"id":"section-2","children":[["$","h2",null,{"className":"text-heading font-semibold text-ink","children":"The new form factor breaks comfortable assumptions"}],[["$","p","For years, it was enough to say that a site should work on phone, tablet, and desktop. Foldable devices add the space between those labels: a narrow outer screen, a wider inner screen, split views, rotation, and width changes while the visitor continues the same task.",{"className":"text-muted","children":"For years, it was enough to say that a site should work on phone, tablet, and desktop. Foldable devices add the space between those labels: a narrow outer screen, a wider inner screen, split views, rotation, and width changes while the visitor continues the same task."}],"$L1b"],"$undefined","$undefined"]}],"$L1c","$L1d","$L1e","$L1f","$L20"],"$L21","$L22"]}]
c:["$","section",null,{"className":"Blog_related__jWACA","children":["$","div",null,{"className":"mx-auto w-full max-w-site px-gutter ","children":[["$","h2",null,{"className":"mb-8 text-heading font-semibold","children":"Keep exploring"}],["$","div",null,{"className":"Blog_grid__6MtqA","children":[["$","article","local-business-homepage-check",{"className":"Blog_card__QJWh_ ","children":[["$","$L4",null,{"href":"/en/blog/homepage-checklist-za-lokalni-biznis/","className":"Blog_image__Wh83s","tabIndex":-1,"aria-hidden":"true","children":["$","$L3",null,{"src":"/blog/lokalni-biznis-treba-da-popravi-na-pocetnoj-stranici.webp","alt":"Illustration of a local business website on a laptop and phone, with icons for contact, trust and the next step.","width":1536,"height":1024,"sizes":"(max-width: 767px) 100vw, 50vw","preload":false}]}],["$","div",null,{"className":"Blog_cardBody__PqnTk","children":[["$","p",null,{"className":"text-small font-semibold text-brand","children":["","Web design"]}],["$","h2",null,{"className":"mt-3 text-subheading font-semibold text-ink","children":["$","$L4",null,{"href":"/en/blog/homepage-checklist-za-lokalni-biznis/","className":"hover:underline underline-offset-4","children":"5 homepage fixes local businesses should make first"}]}],["$","p",null,{"className":"mt-4 text-muted","children":"If a site looks good but doesn’t generate enquiries, the issue is often the homepage structure."}],["$","div",null,{"className":"Blog_meta__K4f3A mt-5","children":[["$","time",null,{"dateTime":"2026-09-15","children":"September 15, 2026"}],["$","span",null,{"children":[3," ","min read"]}]]}],["$","$L4",null,{"href":"/en/blog/homepage-checklist-za-lokalni-biznis/","className":"mt-5 inline-block py-2 text-small font-semibold text-brand underline underline-offset-4","aria-label":"Read article: 5 homepage fixes local businesses should make first","children":["Read article"," ",["$","span",null,{"aria-hidden":"true","children":"↗"}]]}]]}]]}],["$","article","websi