1c:["$","$L1f",null,{"url":"https://nmarkdesigns.com/en/blog/kako-da-portfolio-donosi-kvalitetne-upite/","title":"How to make portfolio pages generate better enquiries","labels":{"title":"Share this article","intro":"Send the article to someone who may find it useful.","facebook":"Facebook","linkedin":"LinkedIn","x":"X","instagram":"Instagram","copy":"Copy link","copied":"Link copied.","instagramLabel":"Copy the link for sharing on Instagram","copyLabel":"Copy article link"}}]
1d:["$","div",null,{"className":"Blog_body__3F_4b","children":[["$","aside",null,{"className":"Blog_answer__uX72u","aria-label":"The short answer","children":[["$","h2",null,{"className":"text-subheading font-semibold","children":"The short answer"}],["$","p",null,{"children":"A portfolio is more useful when imagery is paired with the task, decision and delivered solution. Add evidence where available, state the limits of what you know and offer a relevant next step. A beautiful screenshot alone leaves too many questions unanswered."}]]}],["$","figure",null,{"className":"Blog_figure__N482F","children":[["$","div",null,{"className":"Blog_image__Wh83s","children":["$","$L10",null,{"src":"/blog/da-portfolio-ne-bude-galerija.webp","alt":"Illustration of a website portfolio on a laptop and a notebook sketch of the journey from visitor to enquiry.","width":1536,"height":1024,"sizes":"(max-width: 767px) 100vw, 65vw"}]}],["$","figcaption",null,{"children":"A portfolio should connect project imagery with context and a clear next step."}]]}],[["$","section","Start with the prospective client’s question",{"id":"section-1","children":[["$","h2",null,{"className":"text-heading font-semibold text-ink","children":"Start with the prospective client’s question"}],[["$","p","Visitors are not looking at a project just to judge its colours. They want to know whether you understand a similar problem, what you actually did and whether your reasoning fits their business.",{"className":"text-muted","children":"Visitors are not looking at a project just to judge its colours. They want to know whether you understand a similar problem, what you actually did and whether your reasoning fits their business."}],["$","p","The introduction should therefore name the type of project and its task. Avoid a long technology list before explaining the purpose. Technologies belong later, and only when verified.",{"className":"text-muted","children":"The introduction should therefore name the type of project and its task. Avoid a long technology list before explaining the purpose. Technologies belong later, and only when verified."}]],"$undefined","$undefined"]}],["$","section","Task → decision → delivery",{"id":"section-2","children":[["$","h2",null,{"className":"text-heading font-semibold text-ink","children":"Task → decision → delivery"}],[["$","p","This structure separates needs, approach and outcomes you can genuinely show. The task describes the problem. The decision explains a choice. Delivery states what was built without turning an intention into measured business success.",{"className":"text-muted","children":"This structure separates needs, approach and outcomes you can genuinely show. The task describes the problem. The decision explains a choice. Delivery states what was built without turning an intention into measured business success."}],["$","p","An illustrative example, not a claim about a particular client: a language school wants clearer course information. The decision is to group courses by level. The delivery is a level overview with a path to registration. ‘More registrations’ can be added only when supported by appropriate measurement.",{"className":"text-muted","children":"An illustrative example, not a claim about a particular client: a language school wants clearer course information. The decision is to group courses by level. The delivery is a level overview with a path to registration. ‘More registrations’ can be added only when supported by appropriate measurement."}]],["$","ul",null,{"children":[["$","li","Task: what should the visitor understand or do?",{"children":"Task: what should the visitor understand or do?"}],"$L20","$L21"]}],"$undefined"]}],"$L22","$L23","$L24"],"$L25","$L26"]}]
1e:["$","section",null,{"className":"Blog_related__jWACA","children":["$","div",null,{"className":"mx-auto w-full max-w-site px-gutter ","children":[["$","h2",null,{"className":"mb-8 text-heading font-semibold","children":"Keep exploring"}],["$","div",null,{"className":"Blog_grid__6MtqA","children":[["$","article","iphone-duo-responsive-design",{"className":"Blog_card__QJWh_ ","children":[["$","$Lf",null,{"href":"/en/blog/iphone-duo-responsive-web-dizajn/","className":"Blog_image__Wh83s","tabIndex":-1,"aria-hidden":"true","children":["$","$L10",null,{"src":"/blog/apple-iphone-duo-opening.webp","alt":"Apple iPhone Duo open in hands with the large inner display visible.","width":1312,"height":738,"sizes":"(max-width: 767px) 100vw, 50vw","preload":false}]}],["$","div",null,{"className":"Blog_cardBody__PqnTk","children":[["$","p",null,{"className":"text-small font-semibold text-brand","children":["","Responsive web design"]}],["$","h2",null,{"className":"mt-3 text-subheading font-semibold text-ink","children":["$","$Lf",null,{"href":"/en/blog/iphone-duo-responsive-web-dizajn/","className":"hover:underline underline-offset-4","children":"iPhone Duo changes responsive web design — is your website ready for foldable phones?"}]}],["$","p",null,{"className":"mt-4 text-muted","children":"Foldable phones blur the line between phone and tablet. Responsive web design now needs to be fluid, tested, and ready for more screen states."}],["$","div",null,{"className":"Blog_meta__K4f3A mt-5","children":[["$","time",null,{"dateTime":"2026-09-15","children":"September 15, 2026"}],["$","span",null,{"children":[5," ","min read"]}]]}],["$","$Lf",null,{"href":"/en/blog/iphone-duo-responsive-web-dizajn/","className":"mt-5 inline-block py-2 text-small font-semibold text-brand underline underline-offset-4","aria-label":"Read article: iPhone Duo changes responsive web design — is your website ready for foldable phones?","children":["Read article"," ",["$","span",null,{"aria-hidden":"true","children":"↗"}]]}]]}]]}],["$","article","local-business-homepage-check",{"className":"Blog_card__QJWh_ ","children":[["$","$Lf",null,{"href":"/en/blog/homepage-checklist-za-lokalni-biznis/","className":"Blog_image__Wh83s","tabIndex":-1,"aria-hidden":"true","children":["$","$L10",null,{"src":"/blog/lokalni-biznis-treba-da-popravi-na-pocetnoj-stranici.webp","alt":"Illustration of a local business website on a laptop and phone, with icons for contact, trust and the next step.","width":1536,"height":1024,"sizes":"(max-width: 767px) 100vw, 50vw","preload":false}]}],["$","div",null,{"className":"Blog_cardBody__PqnTk","children":[["$","p",null,{"className":"text-small font-semibold text-brand","children":["","Web design"]}],["$","h2",null,{"className":"mt-3 text-subheading font-semibold text-ink","children":["$","$Lf",null,{"href":"/en/blog/homepage-checklist-za-lokalni-biznis/","className":"hover:underline underline-offset-4","children":"5 homepage fixes local businesses should make first"}]}],["$","p",null,{"className":"mt-4 text-muted","children":"If a site looks good but doesn’t generate enquiries, the issue is often the homepage structure."}],["$","div",null,{"className":"Blog_meta__K4f3A mt-5","children":[["$","time",null,{"dateTime":"2026-09-15","children":"September 15, 2026"}],["$","span",null,{"children":[3," ","min read"]}]]}],["$","$Lf",null,{"href":"/en/blog/homepage-checklist-za-lokalni-biznis/","className":"mt-5 inline-block py-2 text-small font-semibold text-brand underline underline-offset-4","aria-label":"Read article: 5 homepage fixes local businesses should make first","children":["Read article"," ",["$","span",null,{"aria-hidden":"true","children":"↗"}]]}]]}]]}],["$","article","website-audit-framework",{"className":"Blog_card__QJWh_ ","children":[["$","$Lf",null,{"href":"/en/blog/kako-da-radite-brzi-audit-sajta/","className":"Blog_image__Wh83s","tabIndex":-1,"aria-hidden":"true","children":["$","$L10",null,{"src":"/blog/10-minutni-audit-sajta.webp","alt":"Illustration of a person reviewing a website audit checklist beside two website layouts on a laptop.","width":1536,"height":1024,"sizes":"(max-width: 767px) 100vw, 50vw","preload":false}]}],"$L27"]}]]}]]}]}]
