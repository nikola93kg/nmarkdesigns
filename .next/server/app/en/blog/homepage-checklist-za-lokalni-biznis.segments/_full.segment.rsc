20:["$","ul",null,{"children":[["$","li","Follow the main button on every important page.",{"children":"Follow the main button on every important page."}],["$","li","Check that the form explains required fields and errors.",{"children":"Check that the form explains required fields and errors."}],["$","li","Repeat the same action label at the bottom of the page.",{"children":"Repeat the same action label at the bottom of the page."}]]}]
21:["$","section","3. Mobile is a separate test, not a smaller desktop",{"id":"section-3","children":[["$","h2",null,{"className":"text-heading font-semibold text-ink","children":"3. Mobile is a separate test, not a smaller desktop"}],[["$","p","Open the site on a real phone without zooming. A long headline, a menu covering content or a button squeezed against an edge can interrupt an enquiry. Test with a keyboard too: focus must remain visible.",{"className":"text-muted","children":"Open the site on a real phone without zooming. A long headline, a menu covering content or a button squeezed against an edge can interrupt an enquiry. Test with a keyboard too: focus must remain visible."}],["$","p","A large photograph is not inherently a problem. Downloading an unnecessarily large file or shifting content as it loads is. Supply appropriate dimensions and reserve the image’s space in the layout.",{"className":"text-muted","children":"A large photograph is not inherently a problem. Downloading an unnecessarily large file or shifting content as it loads is. Supply appropriate dimensions and reserve the image’s space in the layout."}]],["$","ul",null,{"children":[["$","li","Check text, navigation and contact on a narrow screen.",{"children":"Check text, navigation and contact on a narrow screen."}],["$","li","Do not hide essential information behind hover effects.",{"children":"Do not hide essential information behind hover effects."}],["$","li","Test loading over a mobile connection too.",{"children":"Test loading over a mobile connection too."}]]}],"$undefined"]}]
22:["$","section","4. Build trust with evidence, not superlatives",{"id":"section-4","children":[["$","h2",null,{"className":"text-heading font-semibold text-ink","children":"4. Build trust with evidence, not superlatives"}],[["$","p","Instead of ‘the best quality’, show relevant work and explain what was delivered. A project photograph with a little context is more useful than an anonymous compliment with no source.",{"className":"text-muted","children":"Instead of ‘the best quality’, show relevant work and explain what was delivered. A project photograph with a little context is more useful than an anonymous compliment with no source."}],["$","p","Publish only approved references and verifiable information. Without measurements, describe decisions and scope rather than inventing sales growth. This helps readers and supports an accurate understanding of the page in search.",{"className":"text-muted","children":"Publish only approved references and verifiable information. Without measurements, describe decisions and scope rather than inventing sales growth. This helps readers and supports an accurate understanding of the page in search."}]],"$undefined","$undefined"]}]
23:["$","section","5. Make contact and local details accurate",{"id":"section-5","children":[["$","h2",null,{"className":"text-heading font-semibold text-ink","children":"5. Make contact and local details accurate"}],[["$","p","The business name, phone number and service area should be consistent across the website and business profiles. An address is useful only when it is real and intended to be public. Do not invent a location for a service business without a public office.",{"className":"text-muted","children":"The business name, phone number and service area should be consistent across the website and business profiles. An address is useful only when it is real and intended to be public. Do not invent a location for a service business without a public office."}],["$","p","Finally, ask someone unfamiliar with the site to find a service and send an agreed test enquiry. Note where they hesitate. Fix that obstacle and repeat the task: it is a more concrete next step than redesigning everything on instinct.",{"className":"text-muted","children":"Finally, ask someone unfamiliar with the site to find a service and send an agreed test enquiry. Note where they hesitate. Fix that obstacle and repeat the task: it is a more concrete next step than redesigning everything on instinct."}]],"$undefined","$undefined"]}]
