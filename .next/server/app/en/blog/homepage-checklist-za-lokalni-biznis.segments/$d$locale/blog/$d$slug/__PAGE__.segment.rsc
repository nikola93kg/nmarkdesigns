6:["$","div",null,{"className":"Blog_body__3F_4b","children":[["$","aside",null,{"className":"Blog_answer__uX72u","aria-label":"The short answer","children":[["$","h2",null,{"className":"text-subheading font-semibold","children":"The short answer"}],["$","p",null,{"children":"A useful homepage answers five questions: what you offer, what to do next, whether it works on a phone, why to trust you and how to reach you. Check these before changing colours or adding animation."}]]}],["$","figure",null,{"className":"Blog_figure__N482F","children":[["$","div",null,{"className":"Blog_image__Wh83s","children":["$","$L3",null,{"src":"/blog/lokalni-biznis-treba-da-popravi-na-pocetnoj-stranici.webp","alt":"Illustration of a local business website on a laptop and phone, with icons for contact, trust and the next step.","width":1536,"height":1024,"sizes":"(max-width: 767px) 100vw, 65vw"}]}],["$","figcaption",null,{"children":"A clear offer, mobile usability and easy contact — key checkpoints for a homepage review."}]]}],[["$","section","1. An offer that makes sense before scrolling",{"id":"section-1","children":[["$","h2",null,{"className":"text-heading font-semibold text-ink","children":"1. An offer that makes sense before scrolling"}],[["$","p","Open the homepage and read only the heading and first sentence. Can you tell which service is offered and who it is for? If not, the problem is the message, not the size of the logo.",{"className":"text-muted","children":"Open the homepage and read only the heading and first sentence. Can you tell which service is offered and who it is for? If not, the problem is the message, not the size of the logo."}],["$","p","Imagine a local painting business. ‘Your vision, our passion’ says little about the work. ‘Interior painting and wall preparation’ provides immediate context. Add a service area only if it is accurate; do not insert city names just for keywords.",{"className":"text-muted","children":"Imagine a local painting business. ‘Your vision, our passion’ says little about the work. ‘Interior painting and wall preparation’ provides immediate context. Add a service area only if it is accurate; do not insert city names just for keywords."}]],["$","ul",null,{"children":[["$","li","Name the main service in plain language.",{"children":"Name the main service in plain language."}],["$","li","Explain who it is for in one sentence.",{"children":"Explain who it is for in one sentence."}],["$","li","Remove claims you cannot substantiate.",{"children":"Remove claims you cannot substantiate."}]]}],"$undefined"]}],["$","section","2. One primary action, with no dead ends",{"id":"section-2","children":[["$","h2",null,{"className":"text-heading font-semibold text-ink","children":"2. One primary action, with no dead ends"}],[["$","p","Choose an action that reflects how the business actually works: an enquiry, call or booking. A portfolio can be a secondary link without competing visually with contact.",{"className":"text-muted","children":"Choose an action that reflects how the business actually works: an enquiry, call or booking. A portfolio can be a secondary link without competing visually with contact."}],["$","p","‘Send an enquiry’ is more precise than ‘Learn more’ when the button opens a contact form. After clicking, visitors should get exactly what the label promises. Do not offer a free review unless you actually provide one.",{"className":"text-muted","children":"‘Send an enquiry’ is more precise than ‘Learn more’ when the button opens a contact form. After clicking, visitors should get exactly what the label promises. Do not offer a free review unless you actually provide one."}]],"$L16","$undefined"]}],"$L17","$L18","$L19"],"$L1a","$L1b"]}]
