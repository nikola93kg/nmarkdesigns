a:["$","$L1a",null,{"url":"https://nmarkdesigns.com/sr/blog/iphone-duo-responsive-web-dizajn/","title":"iPhone Duo menja responsive web dizajn — da li je vaš sajt spreman za foldable telefone?","labels":{"title":"Podelite tekst","intro":"Pošaljite članak nekome kome može da koristi.","facebook":"Facebook","linkedin":"LinkedIn","x":"X","instagram":"Instagram","copy":"Kopiraj link","copied":"Link je kopiran.","instagramLabel":"Kopirajte link za deljenje na Instagramu","copyLabel":"Kopirajte link članka"}}]
b:["$","div",null,{"className":"Blog_body__3F_4b","children":[["$","aside",null,{"className":"Blog_answer__uX72u","aria-label":"Ukratko","children":[["$","h2",null,{"className":"text-subheading font-semibold","children":"Ukratko"}],["$","p",null,{"children":"Apple je 9. septembra 2026. predstavio iPhone Duo, prvi foldable iPhone sa 7,6-inčnim unutrašnjim ekranom. Za vlasnike sajtova to nije samo vest o uređaju: to je podsetnik da responsive web dizajn mora da radi kroz raspon širina, gustina i načina držanja uređaja, ne samo na jednom telefonu."}]]}],["$","figure",null,{"className":"Blog_figure__N482F","children":[["$","div",null,{"className":"Blog_image__Wh83s","children":["$","$L3",null,{"src":"/blog/apple-iphone-duo-opening.webp","alt":"Apple iPhone Duo otvoren u rukama sa velikim unutrašnjim ekranom.","width":1312,"height":738,"sizes":"(max-width: 767px) 100vw, 65vw"}]}],["$","figcaption",null,{"children":"Otvoreni unutrašnji ekran iPhone Duo telefona pomera očekivanja od mobilnog prikaza sajta. Izvor fotografije: Apple Newsroom."}]]}],[["$","section","Apple vest je samo povod",{"id":"section-1","children":[["$","h2",null,{"className":"text-heading font-semibold text-ink","children":"Apple vest je samo povod"}],[["$","p","Apple je iPhone Duo predstavio 9. septembra 2026. kao prvi foldable iPhone. Prema Appleovoj objavi, uređaj ima 5,4-inčni spoljašnji ekran i 7,6-inčni unutrašnji ekran, uz prednarudžbine od 16. oktobra i dostupnost od 23. oktobra.",{"className":"text-muted","children":"Apple je iPhone Duo predstavio 9. septembra 2026. kao prvi foldable iPhone. Prema Appleovoj objavi, uređaj ima 5,4-inčni spoljašnji ekran i 7,6-inčni unutrašnji ekran, uz prednarudžbine od 16. oktobra i dostupnost od 23. oktobra."}],["$","p","Zato ovaj tekst nije klasična Apple vest. Važnije pitanje za vlasnike biznisa je jednostavno: ako posetilac otvori vaš sajt na uređaju koji je čas telefon, čas skoro tablet, da li stranica i dalje izgleda namerno, čitljivo i korisno?",{"className":"text-muted","children":"Zato ovaj tekst nije klasična Apple vest. Važnije pitanje za vlasnike biznisa je jednostavno: ako posetilac otvori vaš sajt na uređaju koji je čas telefon, čas skoro tablet, da li stranica i dalje izgleda namerno, čitljivo i korisno?"}]],"$undefined",[["$","figure","/blog/apple-iphone-duo-colors.webp",{"className":"Blog_figure__N482F","children":[["$","div",null,{"className":"Blog_image__Wh83s","children":["$","$L3",null,{"src":"/blog/apple-iphone-duo-colors.webp","alt":"Apple iPhone Duo prikazan u svetloj i tamnoj boji, otvoren i zatvoren.","width":980,"height":551,"sizes":"(max-width: 767px) 100vw, 65vw","loading":"eager"}]}],["$","figcaption",null,{"children":"iPhone Duo u dve boje i dva stanja uređaja. Izvor fotografije: Apple Newsroom."}]]}]]]}],["$","section","Novi form factor ruši udobne pretpostavke",{"id":"section-2","children":[["$","h2",null,{"className":"text-heading font-semibold text-ink","children":"Novi form factor ruši udobne pretpostavke"}],[["$","p","Godinama je bilo dovoljno reći da sajt mora da radi na telefonu, tabletu i desktopu. Foldable uređaji unose međuprostor: uzak spoljašnji ekran, širok unutrašnji ekran, podeljen prikaz, rotaciju, promenu širine dok korisnik nastavlja isti zadatak.",{"className":"text-muted","children":"Godinama je bilo dovoljno reći da sajt mora da radi na telefonu, tabletu i desktopu. Foldable uređaji unose međuprostor: uzak spoljašnji ekran, širok unutrašnji ekran, podeljen prikaz, rotaciju, promenu širine dok korisnik nastavlja isti zadatak."}],["$","p","Problem nije samo veličina ekrana. Problem je kontekst. Korisnik može da počne čitanje na spoljašnjem ekranu, otvori uređaj za detalje, pa nastavi kroz kontakt formu u širem prikazu. Ako layout zavisi od nekoliko krutih tačaka, takva promena brzo otkrije slabosti.",{"className":"text-muted","children":"Problem nije samo veličina ekrana. Problem je kontekst. Korisnik može da počne čitanje na spoljašnjem ekranu, otvori uređaj za detalje, pa nastavi kroz kontakt formu u širem prikazu. Ako layout zavisi od nekoliko krutih tačaka, takva promena brzo otkrije slabosti."}]],"$undefined","$undefined"]}],"$L1b","$L1c","$L1d","$L1e","$L1f"],"$L20","$L21"]}]
