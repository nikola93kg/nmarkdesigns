,null,{"aria-hidden":"true","children":"↗"}]]}]]}]]}],["$","article","local-business-homepage-check",{"className":"Blog_card__QJWh_ ","children":[["$","$Lf",null,{"href":"/sr/blog/homepage-checklist-za-lokalni-biznis/","className":"Blog_image__Wh83s","tabIndex":-1,"aria-hidden":"true","children":["$","$L10",null,{"src":"/blog/lokalni-biznis-treba-da-popravi-na-pocetnoj-stranici.webp","alt":"Ilustracija sajta lokalnog biznisa na laptopu i telefonu, uz ikone kontakta, poverenja i sledećeg koraka.","width":1536,"height":1024,"sizes":"(max-width: 767px) 100vw, 50vw","preload":false}]}],["$","div",null,{"className":"Blog_cardBody__PqnTk","children":[["$","p",null,{"className":"text-small font-semibold text-brand","children":["","Web dizajn"]}],["$","h2",null,{"className":"mt-3 text-subheading font-semibold text-ink","children":["$","$Lf",null,{"href":"/sr/blog/homepage-checklist-za-lokalni-biznis/","className":"hover:underline underline-offset-4","children":"5 stvari koje lokalni biznis treba da popravi na početnoj stranici"}]}],["$","p",null,{"className":"mt-4 text-muted","children":"Ako sajt izgleda lepo, ali ne donosi upite, problem je često u osnovnoj strukturi početne stranice."}],["$","div",null,{"className":"Blog_meta__K4f3A mt-5","children":[["$","time",null,{"dateTime":"2026-09-15","children":"15. septembar 2026."}],["$","span",null,{"children":[3," ","min čitanja"]}]]}],["$","$Lf",null,{"href":"/sr/blog/homepage-checklist-za-lokalni-biznis/","className":"mt-5 inline-block py-2 text-small font-semibold text-brand underline underline-offset-4","aria-label":"Pročitaj članak: 5 stvari koje lokalni biznis treba da popravi na početnoj stranici","children":["Pročitaj članak"," ",["$","span",null,{"aria-hidden":"true","children":"↗"}]]}]]}]]}],["$","article","website-audit-framework",{"className":"Blog_card__QJWh_ ","children":[["$","$Lf",null,{"href":"/sr/blog/kako-da-radite-brzi-audit-sajta/","className":"Blog_image__Wh83s","tabIndex":-1,"aria-hidden":"true","children":["$","$L10",null,{"src":"/blog/10-minutni-audit-sajta.webp","alt":"Ilustracija osobe koja proverava listu za audit sajta uz poređenje dva web prikaza na laptopu.","width":1536,"height":1024,"sizes":"(max-width: 767px) 100vw, 50vw","preload":false}]}],"$L25"]}]]}]]}]}]
20:["$","section","Neka svaka slika nešto objasni",{"id":"section-3","children":[["$","h2",null,{"className":"text-heading font-semibold text-ink","children":"Neka svaka slika nešto objasni"}],[["$","p","Jedna velika naslovna slika daje utisak, ali detalj navigacije ili mobilnog prikaza može da objasni odluku. Birajte slike prema priči koju pričate, ne samo prema tome koliko lepo izgledaju zajedno.",{"className":"text-muted","children":"Jedna velika naslovna slika daje utisak, ali detalj navigacije ili mobilnog prikaza može da objasni odluku. Birajte slike prema priči koju pričate, ne samo prema tome koliko lepo izgledaju zajedno."}],["$","p","Uz sliku napišite šta čitalac treba da primeti. Alternativni tekst neka opiše bitan sadržaj, bez niza SEO ključnih reči. Ne objavljujte privatne podatke iz administracije, analitike ili klijentskih poruka.",{"className":"text-muted","children":"Uz sliku napišite šta čitalac treba da primeti. Alternativni tekst neka opiše bitan sadržaj, bez niza SEO ključnih reči. Ne objavljujte privatne podatke iz administracije, analitike ili klijentskih poruka."}]],["$","ul",null,{"children":[["$","li","Naslovna slika: celina i vizuelni smer.",{"children":"Naslovna slika: celina i vizuelni smer."}],["$","li","Detalj: odluka o sadržaju ili navigaciji.",{"children":"Detalj: odluka o sadržaju ili navigaciji."}],["$","li","Mobilni prikaz: kako se isti zadatak rešava na telefonu.",{"children":"Mobilni prikaz: kako se isti zadatak rešava na telefonu."}]]}],"$undefined"]}]
21:["$","section","Razdvojite dokaz od očekivanja",{"id":"section-4","children":[["$","h2",null,{"className":"text-heading font-semibold text-ink","children":"Razdvojite dokaz od očekivanja"}],[["$","p","‘Jasniji put do prijave’ opisuje nameru dizajna. ‘Prijave su porasle’ je tvrdnja o ponašanju i traži podatke. Ako objavljujete metriku, navedite period, izvor i kontekst koji utiče na poređenje.",{"className":"text-muted","children":"‘Jasniji put do prijave’ opisuje nameru dizajna. ‘Prijave su porasle’ je tvrdnja o ponašanju i traži podatke. Ako objavljujete metriku, navedite period, izvor i kontekst koji utiče na poređenje."}],["$","p","Ako takvih podataka nema, objavite obim rada i proverljive karakteristike. Preciznost nije slabija prodaja: pomaže klijentu da zna šta zapravo dobija. Isto važi za izjave klijenata, koje moraju biti autentične i odobrene.",{"className":"text-muted","children":"Ako takvih podataka nema, objavite obim rada i proverljive karakteristike. Preciznost nije slabija prodaja: pomaže klijentu da zna šta zapravo dobija. Isto važi za izjave klijenata, koje moraju biti autentične i odobrene."}]],"$undefined","$undefined"]}]
22:["$","section","Završite povezanim sledećim korakom",{"id":"section-5","children":[["$","h2",null,{"className":"text-heading font-semibold text-ink","children":"Završite povezanim sledećim korakom"}],[["$","p","Nakon priče ponudite link ka povezanoj usluzi, sličnom projektu ili kontaktu. Tekst linka neka objasni odredište. ‘Pogledajte usluge web dizajna’ daje više konteksta od ‘Kliknite ovde’.",{"className":"text-muted","children":"Nakon priče ponudite link ka povezanoj usluzi, sličnom projektu ili kontaktu. Tekst linka neka objasni odredište. ‘Pogledajte usluge web dizajna’ daje više konteksta od ‘Kliknite ovde’."}],["$","p","Za pretragu i AI čitanje važne informacije stavite u tekst, ne samo u slike. Naslov projekta, kratak odgovor o tome šta je urađeno i jasno organizovani odeljci olakšavaju razumevanje. Strukturirani podaci treba da opisuju isti vidljivi sadržaj, a ne da dodaju nepostojeće nagrade ili ocene.",{"className":"text-muted","children":"Za pretragu i AI čitanje važne informacije stavite u tekst, ne samo u slike. Naslov projekta, kratak odgovor o tome šta je urađeno i jasno organizovani odeljci olakšavaju razumevanje. Strukturirani podaci treba da opisuju isti vidljivi sadržaj, a ne da dodaju nepostojeće nagrade ili ocene."}]],"$undefined","$undefined"]}]
