1d:["$","div",null,{"className":"Blog_body__3F_4b","children":[["$","aside",null,{"className":"Blog_answer__uX72u","aria-label":"Ukratko","children":[["$","h2",null,{"className":"text-subheading font-semibold","children":"Ukratko"}],["$","p",null,{"children":"Portfolio je korisniji kada uz sliku objasni zadatak, odluku i isporučeno rešenje. Dodajte dokaz tamo gde postoji, označite granice onoga što znate i ponudite relevantan sledeći korak. Lep prikaz bez konteksta ostavlja previše pitanja."}]]}],["$","figure",null,{"className":"Blog_figure__N482F","children":[["$","div",null,{"className":"Blog_image__Wh83s","children":["$","$L10",null,{"src":"/blog/da-portfolio-ne-bude-galerija.webp","alt":"Ilustracija portfolija web sajtova na laptopu i skice puta od posetioca do upita u beležnici.","width":1536,"height":1024,"sizes":"(max-width: 767px) 100vw, 65vw"}]}],["$","figcaption",null,{"children":"Portfolio treba da poveže prikaz rada sa kontekstom i jasnim sledećim korakom."}]]}],[["$","section","Počnite od pitanja budućeg klijenta",{"id":"section-1","children":[["$","h2",null,{"className":"text-heading font-semibold text-ink","children":"Počnite od pitanja budućeg klijenta"}],[["$","p","Posetilac ne gleda vaš projekat samo da bi ocenio boje. Želi da razume da li poznajete problem sličan njegovom, šta ste konkretno radili i da li vaš način razmišljanja odgovara njegovom poslu.",{"className":"text-muted","children":"Posetilac ne gleda vaš projekat samo da bi ocenio boje. Želi da razume da li poznajete problem sličan njegovom, šta ste konkretno radili i da li vaš način razmišljanja odgovara njegovom poslu."}],["$","p","Uvod zato treba da navede vrstu projekta i zadatak. Izbegnite dugačak spisak tehnologija pre objašnjenja namene. Tehnologije imaju smisla kasnije, i samo kada su potvrđene.",{"className":"text-muted","children":"Uvod zato treba da navede vrstu projekta i zadatak. Izbegnite dugačak spisak tehnologija pre objašnjenja namene. Tehnologije imaju smisla kasnije, i samo kada su potvrđene."}]],"$undefined","$undefined"]}],["$","section","Zadatak → odluka → isporuka",{"id":"section-2","children":[["$","h2",null,{"className":"text-heading font-semibold text-ink","children":"Zadatak → odluka → isporuka"}],[["$","p","Ova struktura odvaja potrebe od načina rada i rezultata koji zaista možete da pokažete. Zadatak opisuje problem. Odluka objašnjava izbor. Isporuka navodi šta je napravljeno, bez pretvaranja namere u izmereni poslovni uspeh.",{"className":"text-muted","children":"Ova struktura odvaja potrebe od načina rada i rezultata koji zaista možete da pokažete. Zadatak opisuje problem. Odluka objašnjava izbor. Isporuka navodi šta je napravljeno, bez pretvaranja namere u izmereni poslovni uspeh."}],["$","p","Ilustrativni primer, ne tvrdnja o konkretnom klijentu: škola jezika želi jasniji prikaz kurseva. Odluka je da se kursevi grupišu po nivou. Isporuka je pregled nivoa sa putanjom do prijave. ‘Više prijava’ možete dodati tek kada postoji odgovarajuće merenje.",{"className":"text-muted","children":"Ilustrativni primer, ne tvrdnja o konkretnom klijentu: škola jezika želi jasniji prikaz kurseva. Odluka je da se kursevi grupišu po nivou. Isporuka je pregled nivoa sa putanjom do prijave. ‘Više prijava’ možete dodati tek kada postoji odgovarajuće merenje."}]],["$","ul",null,{"children":[["$","li","Zadatak: šta je posetilac trebalo da razume ili uradi?",{"children":"Zadatak: šta je posetilac trebalo da razume ili uradi?"}],["$","li","Odluka: zašto je izabran baš taj raspored?",{"children":"Odluka: zašto je izabran baš taj raspored?"}],["$","li","Isporuka: šta je izrađeno i šta može da se proveri?",{"children":"Isporuka: šta je izrađeno i šta može da se proveri?"}]]}],"$undefined"]}],"$L20","$L21","$L22"],"$L23","$L24"]}]
