,null,{"aria-hidden":"true","children":"↗"}]]}]]}]]}],["$","article","local-business-homepage-check",{"className":"Blog_card__QJWh_ ","children":[["$","$Lf",null,{"href":"/sr/blog/homepage-checklist-za-lokalni-biznis/","className":"Blog_image__Wh83s","tabIndex":-1,"aria-hidden":"true","children":["$","$L10",null,{"src":"/blog/lokalni-biznis-treba-da-popravi-na-pocetnoj-stranici.webp","alt":"Ilustracija sajta lokalnog biznisa na laptopu i telefonu, uz ikone kontakta, poverenja i sledećeg koraka.","width":1536,"height":1024,"sizes":"(max-width: 767px) 100vw, 50vw","preload":false}]}],["$","div",null,{"className":"Blog_cardBody__PqnTk","children":[["$","p",null,{"className":"text-small font-semibold text-brand","children":["","Web dizajn"]}],["$","h2",null,{"className":"mt-3 text-subheading font-semibold text-ink","children":["$","$Lf",null,{"href":"/sr/blog/homepage-checklist-za-lokalni-biznis/","className":"hover:underline underline-offset-4","children":"5 stvari koje lokalni biznis treba da popravi na početnoj stranici"}]}],["$","p",null,{"className":"mt-4 text-muted","children":"Ako sajt izgleda lepo, ali ne donosi upite, problem je često u osnovnoj strukturi početne stranice."}],["$","div",null,{"className":"Blog_meta__K4f3A mt-5","children":[["$","time",null,{"dateTime":"2026-09-15","children":"15. septembar 2026."}],["$","span",null,{"children":[3," ","min čitanja"]}]]}],["$","$Lf",null,{"href":"/sr/blog/homepage-checklist-za-lokalni-biznis/","className":"mt-5 inline-block py-2 text-small font-semibold text-brand underline underline-offset-4","aria-label":"Pročitaj članak: 5 stvari koje lokalni biznis treba da popravi na početnoj stranici","children":["Pročitaj članak"," ",["$","span",null,{"aria-hidden":"true","children":"↗"}]]}]]}]]}],["$","article","portfolio-storytelling",{"className":"Blog_card__QJWh_ ","children":[["$","$Lf",null,{"href":"/sr/blog/kako-da-portfolio-donosi-kvalitetne-upite/","className":"Blog_image__Wh83s","tabIndex":-1,"aria-hidden":"true","children":["$","$L10",null,{"src":"/blog/da-portfolio-ne-bude-galerija.webp","alt":"Ilustracija portfolija web sajtova na laptopu i skice puta od posetioca do upita u beležnici.","width":1536,"height":1024,"sizes":"(max-width: 767px) 100vw, 50vw","preload":false}]}],"$L29"]}]]}]]}]}]
