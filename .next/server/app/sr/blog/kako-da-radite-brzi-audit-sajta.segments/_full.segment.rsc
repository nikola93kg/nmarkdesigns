1e:["$","div",null,{"className":"Blog_body__3F_4b","children":[["$","aside",null,{"className":"Blog_answer__uX72u","aria-label":"Ukratko","children":[["$","h2",null,{"className":"text-subheading font-semibold","children":"Ukratko"}],["$","p",null,{"children":"Za deset minuta možete da pronađete očigledne prepreke, ne da završite tehnički SEO audit. Podelite vreme na ponudu, mobilni prikaz, brzinu, kontakt i prioritete. Sačuvajte URL, dokaz i predlog popravke za svaki problem."}]]}],["$","figure",null,{"className":"Blog_figure__N482F","children":[["$","div",null,{"className":"Blog_image__Wh83s","children":["$","$L10",null,{"src":"/blog/10-minutni-audit-sajta.webp","alt":"Ilustracija osobe koja proverava listu za audit sajta uz poređenje dva web prikaza na laptopu.","width":1536,"height":1024,"sizes":"(max-width: 767px) 100vw, 65vw"}]}],["$","figcaption",null,{"children":"Kratak pregled sajta pretvara uočene prepreke u konkretnu listu za proveru i popravku."}]]}],[["$","section","Minuti 0–2: izaberite zadatak posetioca",{"id":"section-1","children":[["$","h2",null,{"className":"text-heading font-semibold text-ink","children":"Minuti 0–2: izaberite zadatak posetioca"}],[["$","p","Audit bez cilja lako postaje lista ličnih preferencija. Izaberite jedan stvaran zadatak: pronaći uslugu, proveriti ponudu ili poslati upit. Počnite od stranice na koju taj posetilac dolazi, ne nužno od početne.",{"className":"text-muted","children":"Audit bez cilja lako postaje lista ličnih preferencija. Izaberite jedan stvaran zadatak: pronaći uslugu, proveriti ponudu ili poslati upit. Počnite od stranice na koju taj posetilac dolazi, ne nužno od početne."}],["$","p","Zapišite šta očekujete da pročitate i koji sledeći korak tražite. Ako ponuda nije jasna, navedite tačnu rečenicu koja zbunjuje i predložite precizniju, umesto komentara ‘tekst treba poboljšati’.",{"className":"text-muted","children":"Zapišite šta očekujete da pročitate i koji sledeći korak tražite. Ako ponuda nije jasna, navedite tačnu rečenicu koja zbunjuje i predložite precizniju, umesto komentara ‘tekst treba poboljšati’."}]],"$undefined","$undefined"]}],["$","section","Minuti 2–4: prođite mobilni put",{"id":"section-2","children":[["$","h2",null,{"className":"text-heading font-semibold text-ink","children":"Minuti 2–4: prođite mobilni put"}],[["$","p","Na telefonu otvorite meni, pronađite uslugu i dođite do kontakta. Proverite da li tekst staje u ekran i da li lepljivi elementi prekrivaju dugmad. Zatim prođite glavne kontrole tastaturom na računaru.",{"className":"text-muted","children":"Na telefonu otvorite meni, pronađite uslugu i dođite do kontakta. Proverite da li tekst staje u ekran i da li lepljivi elementi prekrivaju dugmad. Zatim prođite glavne kontrole tastaturom na računaru."}],["$","p","Snimak ekrana je koristan dokaz problema sa rasporedom. Uz njega navedite širinu ekrana i korake do greške. Samo ‘na telefonu ne radi’ ne daje dovoljno informacija za popravku.",{"className":"text-muted","children":"Snimak ekrana je koristan dokaz problema sa rasporedom. Uz njega navedite širinu ekrana i korake do greške. Samo ‘na telefonu ne radi’ ne daje dovoljno informacija za popravku."}]],["$","ul",null,{"children":[["$","li","Da li linkovi vode tamo gde njihov naziv obećava?",{"children":"Da li linkovi vode tamo gde njihov naziv obećava?"}],["$","li","Da li se fokus vidi i bez miša?",{"children":"Da li se fokus vidi i bez miša?"}],["$","li","Da li je moguće zatvoriti meni i vratiti se na sadržaj?",{"children":"Da li je moguće zatvoriti meni i vratiti se na sadržaj?"}]]}],"$undefined"]}],["$","section","Minuti 4–6: brzina bez lova na savršenu ocenu",{"id":"section-3","children":["$L21",["$L22","$L23"],"$undefined","$undefined"]}],"$L24","$L25","$L26"],"$L27","$L28"]}]
