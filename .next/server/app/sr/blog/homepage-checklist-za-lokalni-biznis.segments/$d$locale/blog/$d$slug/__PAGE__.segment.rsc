7:["$","div",null,{"className":"Blog_body__3F_4b","children":[["$","aside",null,{"className":"Blog_answer__uX72u","aria-label":"Ukratko","children":[["$","h2",null,{"className":"text-subheading font-semibold","children":"Ukratko"}],["$","p",null,{"children":"Dobra početna stranica odgovara na pet pitanja: šta nudite, šta posetilac treba da uradi, da li to može na telefonu, zašto da vam veruje i kako da vas kontaktira. Proverite tih pet tačaka pre nego što menjate boje ili dodajete animacije."}]]}],["$","figure",null,{"className":"Blog_figure__N482F","children":[["$","div",null,{"className":"Blog_image__Wh83s","children":["$","$L3",null,{"src":"/blog/lokalni-biznis-treba-da-popravi-na-pocetnoj-stranici.webp","alt":"Ilustracija sajta lokalnog biznisa na laptopu i telefonu, uz ikone kontakta, poverenja i sledećeg koraka.","width":1536,"height":1024,"sizes":"(max-width: 767px) 100vw, 65vw"}]}],["$","figcaption",null,{"children":"Jasna ponuda, mobilni prikaz i lak kontakt — ključne tačke za proveru početne stranice."}]]}],[["$","section","1. Ponuda koju razumete bez skrolovanja",{"id":"section-1","children":[["$","h2",null,{"className":"text-heading font-semibold text-ink","children":"1. Ponuda koju razumete bez skrolovanja"}],[["$","p","Otvorite početnu stranicu i pročitajte samo naslov i prvu rečenicu. Da li biste znali koju uslugu dobijate i za koga je namenjena? Ako ne, problem nije u veličini logotipa nego u poruci.",{"className":"text-muted","children":"Otvorite početnu stranicu i pročitajte samo naslov i prvu rečenicu. Da li biste znali koju uslugu dobijate i za koga je namenjena? Ako ne, problem nije u veličini logotipa nego u poruci."}],["$","p","Zamislite lokalnu molersku firmu. ‘Vaša vizija, naša strast’ ne govori šta radi. ‘Krečenje i gletovanje stanova’ daje kontekst odmah. Dodajte područje rada samo ako je tačno; nemojte ubacivati gradove radi ključnih reči.",{"className":"text-muted","children":"Zamislite lokalnu molersku firmu. ‘Vaša vizija, naša strast’ ne govori šta radi. ‘Krečenje i gletovanje stanova’ daje kontekst odmah. Dodajte područje rada samo ako je tačno; nemojte ubacivati gradove radi ključnih reči."}]],["$","ul",null,{"children":[["$","li","Napišite glavnu uslugu običnim jezikom.",{"children":"Napišite glavnu uslugu običnim jezikom."}],["$","li","Objasnite kome je namenjena u jednoj rečenici.",{"children":"Objasnite kome je namenjena u jednoj rečenici."}],["$","li","Uklonite tvrdnje koje ne možete da potkrepite.",{"children":"Uklonite tvrdnje koje ne možete da potkrepite."}]]}],"$undefined"]}],["$","section","2. Jedna glavna akcija, bez slepih ulica",{"id":"section-2","children":[["$","h2",null,{"className":"text-heading font-semibold text-ink","children":"2. Jedna glavna akcija, bez slepih ulica"}],[["$","p","Izaberite akciju koja odgovara načinu na koji zaista poslujete: upit, poziv ili rezervacija. Portfolio može da bude sekundarni link, ali ne mora da izgleda jednako važno kao kontakt.",{"className":"text-muted","children":"Izaberite akciju koja odgovara načinu na koji zaista poslujete: upit, poziv ili rezervacija. Portfolio može da bude sekundarni link, ali ne mora da izgleda jednako važno kao kontakt."}],["$","p","‘Pošaljite upit’ je preciznije od ‘Saznajte više’ kada dugme otvara kontakt. Nakon klika posetilac treba da dobije upravo ono što tekst obećava. Ne nudite besplatnu procenu ako je zaista ne pružate.",{"className":"text-muted","children":"‘Pošaljite upit’ je preciznije od ‘Saznajte više’ kada dugme otvara kontakt. Nakon klika posetilac treba da dobije upravo ono što tekst obećava. Ne nudite besplatnu procenu ako je zaista ne pružate."}]],"$L17","$undefined"]}],"$L18","$L19","$L1a"],"$L1b","$L1c"]}]
