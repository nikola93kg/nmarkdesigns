# Keep false on every development/preview build. Rebuild when changing SEO mode.
SITE_LAUNCH=false

# Self-hosted production must explicitly set production at build time.
# On Vercel, VERCEL_ENV takes precedence; preview/development always stay blocked.
DEPLOYMENT_ENV=development

# Hostinger SMTP Configuration (Phase 1A)
# Hostinger mail server settings
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@nmarkdesigns.com
SMTP_PASSWORD=nMarkovic12#
CONTACT_RECIPIENT=info@nmarkdesigns.com

# Anti-Spam: Cloudflare Turnstile (Optional - leave empty to skip Turnstile verification in dev/tests)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxxxxxxxxxx
# TURNSTILE_SECRET_KEY=0x4AAAAAAAyyyyyyyyyyyyyyyyyyyyyy
