# Copy required values into your LOCAL environment, never commit real secrets.
# Local demo is enabled by default under npm run dev; no env file is needed.
# Set CHAT_ENABLED=false for production until the complete MVP is approved.
CHAT_ENABLED=true
# Development only. Set false explicitly when testing the real configured backend.
CHAT_PREVIEW=true
# Explicit loopback-only development test; production ignores this flag.
# With CHAT_PREVIEW=false, links to the local processing notice instead of a production policy.
CHAT_LOCAL_TEST=false
CHAT_ORIGIN=http://127.0.0.1:3000
CHAT_IDENTITY_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Required paid-generation ceilings (0 means disabled), covering scope checks AND answers.
# Greetings/obvious unrelated redirects use no paid generation. Monetary caps are separate.
CHAT_MAX_CALLS_DAY=0
CHAT_MAX_CALLS_MONTH=0
CHAT_MAX_OUTPUT_TOKENS=600
CHAT_TIMEOUT_MS=35000
# No default IP header: all visitors share a conservative fallback bucket.
# Set ONLY after verifying Hostinger overwrites it and the app cannot bypass the proxy.
CHAT_TRUSTED_IP_HEADER=
# Verified, published, approved policy URLs required for BOTH locales.
CHAT_PRIVACY_URL_SR=
CHAT_PRIVACY_URL_EN=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nmark_chatbot_dev
DB_USER=
DB_PASSWORD=
CHAT_MIGRATION_TARGET=development
# Exact owner identity; never infer the admin from the public email.
ADMIN_ALLOWED_EMAIL=
# Email is a separate opt-in; leave false until delivery/cron are reviewed.
CHAT_EMAIL_ENABLED=false
CHAT_LEAD_RECIPIENT=info@nmarkdesigns.com
CHAT_CRON_SECRET=
# Existing SMTP_HOST / SMTP_PORT / SMTP_SECURE / SMTP_USER / SMTP_PASSWORD are reused.
# Owner-only Auth.js admin. The exact allowed email must be confirmed by the owner.
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# ADMIN_ALLOWED_EMAIL is defined above; set it only in the private runtime environment.

# Owner-approved initial USD limits (2026-11-19). UTC day/calendar month.
CHAT_BUDGET_DAY_USD=0.50
CHAT_BUDGET_MONTH_USD=4
# Standard text prices verified 2026-11-19 against official OpenAI model docs.
# Required explicit prices for exactly OPENAI_MODEL; no guessed price for an unknown model.
CHAT_PRICE_MODEL=gpt-5.4-mini
CHAT_PRICE_INPUT_USD_PER_MILLION=0.75
CHAT_PRICE_OUTPUT_USD_PER_MILLION=4.50
# Owner-approved policy: 90d inactive without leads, 365d since latest lead.
# Enable after migrations, backfill, backup and scheduling have been reviewed for the target.
CHAT_RETENTION_ENABLED=false
# Quote SMTP_PASSWORD if it contains #; escape $ as \$ for Next.js expansion.
