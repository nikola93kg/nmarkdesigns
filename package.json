{
  "name": "nmarkdesigns",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "playwright test",
    "test:chatbot": "playwright test --config playwright.chatbot.config.ts",
    "chat:db:generate": "drizzle-kit generate",
    "chat:db:migrate:dev": "node --env-file=.env.local lib/chatbot/migrate.mjs",
    "test:admin": "playwright test --config playwright.admin.config.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "1.11.3",
    "@tailwindcss/postcss": "4.3.3",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "1.42.0",
    "mysql2": "^3.24.6",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "^10.5.0",
    "openai": "^7.60.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwindcss": "4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "drizzle-kit": "^0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "typescript": "6.0.3"
  },
  "overrides": {
    "source-map-js": "^1.2.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.7",
    "minimatch": "^11.0.5",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    },
    "nodemailer": "$nodemailer"
  }
}
